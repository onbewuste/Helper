{
  "manifest_version": 3,
  "name": "Helper",
  "version": "1.9.6",
  "description": "Hotelhulpmiddel met rondlopen, streamermodus, Furniture Inspector en kamerbouw met catalogusanalyse.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.leet.city/*", "https://leet.city/*"],
  "icons": {
    "16": "icons/helper-16.png",
    "32": "icons/helper-32.png",
    "48": "icons/helper-48.png",
    "128": "icons/helper-128.png"
  },
  "action": {
    "default_title": "Helper",
    "default_icon": {
      "16": "icons/helper-16.png",
      "32": "icons/helper-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.leet.city/*", "https://leet.city/*"],
      "js": ["haak.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.leet.city/*", "https://leet.city/*"],
      "js": ["brug.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
